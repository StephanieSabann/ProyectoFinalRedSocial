{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FotosEnS3",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::NOMBRE-DEL-BUCKET/*"
    },
    {
      "Sid": "ListarBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::NOMBRE-DEL-BUCKET"
    },
    {
      "Sid": "RekognitionOpcional",
      "Effect": "Allow",
      "Action": ["rekognition:DetectLabels", "rekognition:DetectModerationLabels"],
      "Resource": "*"
    }
  ]
}
